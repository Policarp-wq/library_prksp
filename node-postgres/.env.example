# Copy this file to .env and fill in real values. Never commit .env.
# Required in any environment.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<replace-with-strong-db-password>
PGDATABASE=books_db

# JWT signing secret. Must be a random string of at least 32 chars in production.
# Generate, e.g., with: openssl rand -base64 48
JWT_SECRET=<replace-with-random-secret-at-least-32-chars>

PORT=3000
NODE_ENV=development

# Optional: seed demonstration users on first DB init.
# Disabled by default. Set to "true" only for local demos / test environments.
# When enabled, SEED_*_PASSWORD values are required, otherwise seed is skipped.
SEED_DEMO_USERS=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_USER_USERNAME=user
SEED_USER_PASSWORD=
